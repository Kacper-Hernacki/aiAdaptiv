# Public base URL of the site — used for canonical URLs, sitemap, robots,
# Open Graph, and JSON-LD. Set this to your real production domain.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.aiadaptiv.ai

# Booking link behind every primary CTA. Unset falls back to the Cal.com
# "AI mapping call" event type in src/config/site.ts.
NEXT_PUBLIC_BOOKING_URL=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Create a GA4 property at
# analytics.google.com, add a Web data stream for your domain, and copy the
# Measurement ID here. Empty means GA is not loaded. Public by necessity (the
# gtag script runs in the browser).
NEXT_PUBLIC_GA_ID=

# Google Search Console verification. In Search Console, add a property, pick the
# "HTML tag" verification method, and copy the content="..." value here. Leaving
# this empty renders no tag. This is the only setup needed — Vercel Analytics
# turns on automatically once the site is deployed on Vercel.
GOOGLE_SITE_VERIFICATION=

# --- Stripe Checkout (optional) ---------------------------------------------
# The pricing "Reserve" button POSTs to /api/checkout. Until these are set the
# route returns 503 and the button falls back to the Tally application form.
# Founding-partner checkout = monthly subscription (€249) + one-time setup fee
# (€1,999) added to the first invoice.
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_SETUP=

# --- Inbound enquiry form (/api/lead) ----------------------------------------
# The 3-step form under the hero. It stores every submission in Turso, emails
# you a notification, sends the submitter a confirmation, and optionally mirrors
# the person into Instantly. Each destination is independent: whatever is
# configured runs, the rest is skipped. With NEITHER Turso nor Resend set the
# route returns 500 rather than pretending a lead was received.

# Turso (libSQL). The durable record — the `leads` table is created on first
# write, so there is no migration step.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Resend. Sends the notification to you and the confirmation to them.
RESEND_API_KEY=
# Sender. MUST be a domain verified in Resend, or every send 403s.
LEAD_FROM_EMAIL="aiAdaptiv <hello@aiadaptiv.com>"
# Where notifications land. Defaults to contactEmail in src/config/site.ts.
LEAD_NOTIFY_EMAIL=

# Instantly (optional). Both must be set or the push is skipped entirely.
# Use a LIST id, never an active campaign — a campaign would enrol an inbound
# lead in a cold sequence and email them.
INSTANTLY_API_KEY=
INSTANTLY_LIST_ID=
